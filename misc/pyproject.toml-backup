[tool.poetry]
name = "edh_data_reader"
version = "1.0.0"
description = ""
authors = ["Khaja Asmath <khaja_asmath_mohammed@baxter.com>"]
packages = [
    { include = "lib" }
]

[tool.poetry.dependencies]
python = "^3.8.10, <3.12"
pyspark = "^3.1.1"
boto3 = "^1.24.48"
unicodecsv = "^0.14.1"
simple-salesforce = "^1.12.2"
salesforce-bulk = "^2.2.0"
cx-oracle = "^8.3.0"
pyyaml = "^6.0.1"
mysql = "^0.0.3"
mysql-connector = "^2.2.9"
cryptography = "^41.0.7"
psycopg2 = "^2.9.9"
sqlparse = "^0.4.4"
pre-commit="^2.21.0"
flake8   = "^6.0.0"
elasticsearch   = "^7.13.4"
pandas   = "^1.1.5"
pyodbc   = "^4.0.27"
requests_aws4auth   = "^1.2.3"
snowflake   = "^0.6.0"
tabulate   = "^0.9.0"

[tool.poetry.dev-dependencies]
pyspark = "3.1.1"
boto3 = "^1.24.48"

[build-system]
requires = ["poetry-core>=1.0.0"]
build-backend = "poetry.core.masonry.api"
